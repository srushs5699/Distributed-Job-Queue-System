# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here

# Worker Configuration
QUEUE=default
WORKER_TIMEOUT=600

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Performance Tuning
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
RQ_RESULT_TTL=86400

# Optional: External Redis (Production)
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=true